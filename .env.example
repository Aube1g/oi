# Copy this file to ~/.xli/.env (or export these in your shell) and fill in
# whichever provider(s) you actually use. Config.get_api_key() reads these
# names — see xli/core/config.py.

# Default provider is "mistral" (xli/core/config.py: DEFAULTS["provider"]).
# Override in ~/.xli/config.json, e.g. {"provider": "openai"}.

MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_API_KEY is recognized by get_api_key() but there's currently no
# xli/providers/gemini.py — using provider "gemini"/"google" will raise
# "Unknown provider" until one is added.
GEMINI_API_KEY=

# --- Sandbox (xli/core/sandbox.py, defaults shown) ---
# SANDBOX_TIMEOUT / SANDBOX_MAX_MEMORY_MB are not read from env today (only
# from ~/.xli/config.json); listed here as a reminder of what's configurable:
#   sandbox_timeout: 10          (seconds)
#   sandbox_max_memory_mb: 256
#   sandbox_disable_network: true

# --- Autonomy mode (xli/core/chain.py: AutonomyMode) ---
# Controls how much XliCore does on its own. Read by headless.py/tui.py at
# startup via AutonomyMode.from_env(); unset = "manual" (old behavior).
#   manual     — DEBUGGER runs once, blind; no automatic idle reconciliation.
#   assisted   — real pytest-driven DEBUGGER<->TESTER retry loop; idle
#                reconciliation still needs to be driven manually.
#   autonomous — both: self-correction loop AND idle reconciliation run
#                automatically across run_chain() calls.
XLI_AUTONOMY_MODE=manual

# --- Neovim integration (optional, xli/core/env.py) ---
NVIM_LISTEN_ADDRESS=
